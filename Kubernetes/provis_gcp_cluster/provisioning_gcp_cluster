gcloud auth login
gcloud config set project <YOUR_PROJECT_ID>
gcloud config set compute/zone europe-west1-b

gcloud services enable compute.googleapis.com

gcloud compute networks create pet1-net --subnet-mode=custom
gcloud compute networks subnets create pet1-subnet \
  --network=pet1-net --range=10.240.0.0/24

gcloud compute firewall-rules create pet1-allow-internal \
  --network=pet1-net --allow tcp,udp,icmp \
  --source-ranges=10.240.0.0/24

gcloud compute firewall-rules create pet1-allow-external \
  --network=pet1-net --allow tcp:22,tcp:6443,tcp:80,tcp:443,tcp:8080,tcp:8443,tcp:4180,icmp \
  --source-ranges=0.0.0.0/0

  gcloud compute firewall-rules create allow-calico-ipip \
  --network=pet1-net \
  --direction=INGRESS \
  --priority=1000 \
  --action=ALLOW \
  --rules=ipip \
  --source-ranges=0.0.0.0/0

# install nginx, replace nginx.conf with required one, then start script for creating ssl certs, use redirects as a variables of private ips
gcloud compute instances create nginx-balancer \
  --zone=europe-west4-a \
  --machine-type=e2-micro \
  --subnet=pet1-subnet \
  --network=pet1-net \
  --image-family=ubuntu-2204-lts \
  --image-project=ubuntu-os-cloud \
  --boot-disk-size=10GB \
  --boot-disk-type=pd-standard \
  --tags=balancer \
  --private-network-ip=10.240.0.80

gcloud compute instances create k8s-master \
  --zone=europe-west4-a \
  --machine-type=e2-medium \
  --subnet=pet1-subnet \
  --network=pet1-net \
  --image-family=ubuntu-2204-lts \
  --image-project=ubuntu-os-cloud \
  --boot-disk-size=35GB \
  --boot-disk-type=pd-standard \
  --tags=k8s \
  --private-network-ip=10.240.0.10

gcloud compute instances create k8s-worker-1 k8s-worker-2 \
  --zone=europe-west4-a \
  --machine-type=e2-small \
  --subnet=pet1-subnet \
  --network=pet1-net \
  --image-family=ubuntu-2204-lts \
  --image-project=ubuntu-os-cloud \
  --boot-disk-size=25GB \
  --boot-disk-type=pd-standard \
  --tags=k8s \
  --private-network-ip=10.240.0.11,10.240.0.12

